# Copy this file to `.env` for local development. Do NOT commit `.env`.
# In CI and production, secrets are injected by the secret manager
# (see docs/secrets-management.md).

# ---- Environment ----
GUARDIAN_ENVIRONMENT=development

# ---- LLM ----
GUARDIAN_LLM_PROVIDER=anthropic
GUARDIAN_LLM_PRIMARY_MODEL=claude-sonnet-4-5
GUARDIAN_LLM_FALLBACK_MODEL=claude-haiku-4-5
GUARDIAN_LLM_TEMPERATURE=0.1
GUARDIAN_LLM_MAX_TOKENS_PER_ANALYSIS=4000
GUARDIAN_LLM_BUDGET_USD_PER_PR=1.0
GUARDIAN_LLM_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---- RAG / Vector store ----
GUARDIAN_RAG_QDRANT_URL=http://localhost:6333
GUARDIAN_RAG_QDRANT_API_KEY=
GUARDIAN_RAG_EMBEDDINGS_PROVIDER=voyage
GUARDIAN_RAG_VOYAGE_API_KEY=
GUARDIAN_RAG_OPENAI_API_KEY=
GUARDIAN_RAG_TOP_K=5

# ---- Observability (Langfuse) ----
GUARDIAN_OBS_LANGFUSE_HOST=http://localhost:3000
GUARDIAN_OBS_LANGFUSE_PUBLIC_KEY=
GUARDIAN_OBS_LANGFUSE_SECRET_KEY=
GUARDIAN_OBS_LOG_LEVEL=INFO
GUARDIAN_OBS_LOG_FORMAT=console
